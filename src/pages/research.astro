---
import Layout from "@/layouts/Layout.astro";
import { profile } from "@/settings";
import BetterIcon from "@/components/ui/BetterIcon.astro";
import List from "@/components/ui/List.astro";
import {RESEARCH_ICONS} from "@/data/researchIcons";

const { research_areas } = profile;
---

<Layout title="Tentang Saya | Airin Nur Azizah">
  <div class="prose max-w-none">
    <h1 class="text-3xl font-bold mb-8">Tentang Saya</h1>

    <div class="mb-12">
      <p class="text-lg mb-6">
        Saya adalah mahasiswa program studi S1 Statistika di Universitas Cenderawasih yang memiliki ketertarikan pada pengolahan dan analisis data.
      </p>
      <p class="text-lg mb-6">
        Saya berfokus pada pengembangan Microsoft Word, Microsoft Excel, dan Python untuk mengolah data, membuat visualisasi, serta pola yang dapat mendukung pengambilan keputusan.
      </p>
    </div>

    <h2 class="text-2xl font-bold mb-6">Bidang Minat</h2>
    <div class="grid gap-8 mb-12">
      {
        research_areas.map((area) => (
          <div class="flex gap-6 items-start">
            <BetterIcon>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke-width="2"
                class="size-6 stroke-accent"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d={RESEARCH_ICONS[area.field as keyof typeof RESEARCH_ICONS]?.path || RESEARCH_ICONS['computer-science'].path}
                />
              </svg>
            </BetterIcon>
            <div>
              <h3 class="text-xl font-semibold mb-2">{area.title}</h3>
              <p class="text-base">{area.description}</p>
            </div>
          </div>
        ))
      }
    </div>

    <List listTitle="Pencapaian" listItems={[
      {
        title: "Juara 2 OSN Ekonomi Tingkat Sekolah",
        description: "Meraih Juara 2 pada Olimpiade Sains Nasional bidang Ekonomi tingkat sekolah tahun 2025."
      },
      {
        title: "Peserta Youth Leadership Festival 2",
        description: "Mengikuti Youth Leadership Festival 2 sebagai bagian dari pengalaman belajar kepemimpinan."
      }
    ]} />

    <h2 class="text-2xl font-bold mb-6">Tujuan</h2>
    <p class="text-lg mb-6">
      Saya ingin terus mengembangkan kemampuan statistika dan analisis data melalui proyek akademik, pelatihan, serta pengalaman kerja untuk menjadi seorang data analyst.
    </p>
  </div>
</Layout>
