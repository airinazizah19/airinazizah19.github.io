---
import { Image } from 'astro:assets'

import SocialIcons from './SocialIcons.astro'


const {fullName, title, institute, profilePicture} = Astro.props
---
<div class='flex-1'>
  <h1 class='text-4xl font-bold mb-4'>
    Halo! Saya <span class='text-secondary'>{fullName}</span>
  </h1>
  <p class='text-xl text-gray-600 mb-4'>{title}{institute ? ` di ${institute}` : ''}</p>
  <p class='text-lg mb-6'>
    Saya adalah mahasiswa program studi statistika yang memiliki ketertarikan dalam bidang matematika, pengolahan data, dan analisis informasi.
  Saya juga tertarik pada pengembangan teknologi,
  riset, dan penerapan solusi digital untuk pendidikan dan masyarakat.
  Fokus saya adalah menciptakan karya yang bermanfaat, inovatif, dan mudah digunakan.
  </p>
  <div class='flex gap-4'>
    <SocialIcons />
  </div>
</div>
<div class='size-72 lg:block hidden'>
  <!-- Add your profile image -->
  <Image
    src={profilePicture}
    alt={fullName}
    class='w-full h-full mask mask-circle size-44'
  />
</div>
